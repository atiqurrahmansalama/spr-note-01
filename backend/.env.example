# PostgreSQL Production Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spr_note_db

# Alternative individual PostgreSQL Environment Variables
POSTGRES_DB=spr_note_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Developer Fallback (Set to True only for quick local testing without PostgreSQL server)
USE_SQLITE=False

# Django Security Settings
SECRET_KEY=your-production-secret-key-change-in-prod
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
