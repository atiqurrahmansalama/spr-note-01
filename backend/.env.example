# ==============================================================================
# SPR Note (TaleemOS) Enterprise Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spr_note_db
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=600

# Developer Fallback (Set to True only for quick local testing without PostgreSQL)
USE_SQLITE=False

# Redis & Caching Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/0

# Celery Asynchronous Task Queue
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=False

# Security Settings
SECRET_KEY=your-secure-production-secret-key-min-50-chars
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Sentry APM Observability (Optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
ENVIRONMENT=production

# Email / SMTP Settings (Optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SPR Note <noreply@sprnote.com>
