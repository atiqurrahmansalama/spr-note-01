# ==============================================================================
# SPR Note (TaleemOS) Frontend Environment Configuration Template
# ==============================================================================

# Backend API Base URL (e.g. http://127.0.0.1:8000 or https://your-backend.vercel.app)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth 2.0 Client ID (Web Client ID from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

# Google Maps JavaScript & Places API Key (Optional - Falls back to OpenStreetMap Nominatim)
VITE_GOOGLE_MAPS_API_KEY=
